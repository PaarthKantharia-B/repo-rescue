# ==============================================================================
# REPO RESCUE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env in production environment and supply actual values.
# DO NOT commit real secrets or credentials to source control.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Primary connection pool URL (e.g. Supabase / Neon / AWS RDS / Railway PostgreSQL)
DATABASE_URL="postgresql://user:password@db-host:5432/repo_rescue?schema=public&sslmode=require"

# Direct connection URL (used for migrations and direct Prisma queries)
DIRECT_URL="postgresql://user:password@db-host:5432/repo_rescue?schema=public&sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL of the deployed application (MUST match production domain, e.g. https://repo-rescue.com)
NEXTAUTH_URL="https://your-production-domain.com"

# NextAuth secret key used to sign & encrypt JWT cookies
NEXTAUTH_SECRET="your-generate-32-char-random-secret-key"

# ------------------------------------------------------------------------------
# 3. GITHUB OAUTH APPLICATION CREDENTIALS
# ------------------------------------------------------------------------------
# Registered at https://github.com/settings/applications/new
# Authorization callback URL: https://your-production-domain.com/api/auth/callback/github
GITHUB_CLIENT_ID="your_production_github_client_id"
GITHUB_CLIENT_SECRET="your_production_github_client_secret"

# ------------------------------------------------------------------------------
# 4. GITHUB WEBHOOKS & REST API CREDENTIALS
# ------------------------------------------------------------------------------
# Shared secret for verifying GitHub HMAC-SHA256 signatures on incoming webhooks
# Configured at Organization / Repository settings -> Webhooks -> Payload Secret
GITHUB_WEBHOOK_SECRET="your-production-webhook-hmac-secret-key"

# GitHub Personal Access Token (PAT) used for REST API rate-limit headroom on issue backfills
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# ------------------------------------------------------------------------------
# 5. TALK TO THE FOUNDER (GMAIL SMTP CONFIGURATION)
# ------------------------------------------------------------------------------
# Target founder feedback destination email address
FOUNDER_EMAIL="themidnightcompanion@gmail.com"

# SMTP Mail Server (Gmail SMTP: smtp.gmail.com)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="themidnightcompanion@gmail.com"
SMTP_SECURE=false

# Sender header display name and email
SMTP_FROM="\"Repo Rescue Founder Feedback\" <themidnightcompanion@gmail.com>"

# 16-character Gmail App Password (generated at https://myaccount.google.com/apppasswords)
SMTP_PASS="your_16_char_gmail_app_password"
